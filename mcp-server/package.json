{
  "name": "iw4x-toolkit-mcp",
  "version": "2.0.0",
  "description": "IW4X/MW2 modding toolkit — MCP server and iw4x-toolkit CLI for IWD archives, GSC tooling, and DVAR reference",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/index.ts src/bin.ts --bundle --platform=node --format=esm --outdir=dist \"--banner:js=import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "dev": "tsc --watch",
    "test": "vitest run",
    "docs": "typedoc --options typedoc.json",
    "docs:watch": "typedoc --options typedoc.json --watch",
    "build:binary": "bun build src/bin.ts --compile --outfile dist/iw4x-toolkit",
    "knowledge": "esbuild scripts/build-knowledge.ts --bundle --platform=node --format=esm --outfile=dist/build-knowledge.mjs --log-level=warning && node dist/build-knowledge.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "adm-zip": "^0.6.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^24.13.5",
    "esbuild": "^0.28.2",
    "typedoc": "^0.28.20",
    "typescript": "~5.9.3",
    "vitest": "^5.0.1"
  },
  "bin": {
    "iw4x-toolkit": "dist/bin.js"
  }
}
